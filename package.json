{
  "name": "fitness-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun --watch src/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "bun src/index.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
